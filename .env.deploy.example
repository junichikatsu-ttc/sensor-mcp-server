# deploy.mjs（npm run enebular:*）の設定。.env.deploy にコピーして値を入れる（git 管理外）。
# 同名の環境変数があればそちらが優先。コメントは行頭 # のみ（値の後ろに書かない）。

# ===== enebular CLI（デプロイ操作用。アカウント設定画面で発行） =====
# 未設定なら CLI 側の ~/.enebular/credentials（default プロファイル）で認証する
ENEBULAR_ACCESS_KEY=
ENEBULAR_SECRET_KEY=

# コンソールで作成したプロジェクトの ID
ENEBULAR_PROJECT_ID=
# 空のまま `npm run enebular:init` を実行するとファイルアセットが作成され、ここに書き戻される
ENEBULAR_FILE_ASSET_ID=
ENEBULAR_FILE_ASSET_NAME=sensor-mcp-server-function
# コンソールで作成したクラウド実行環境の ID（アセット作成後に作る。ランタイム Node.js 22.x）
ENEBULAR_CLOUD_ID=
# 任意: クラウド実行環境の表示名を変える（1〜30 文字の英数字 _ -）
# ENEBULAR_CLOUD_NAME=sensor-mcp-server-staging

# HTTP トリガーのパス（先頭スラッシュなし。インスタンス内で一意）。空なら ENEBULAR_HTTP_TRIGGER_URL の末尾パスから導く
ENEBULAR_HTTP_TRIGGER_PATH=
# トリガーの URL（例: https://xxxx.enebular.com/sensor-mcp-server）。スモークテストで使う。空ならスキップ
ENEBULAR_HTTP_TRIGGER_URL=
# 関数のタイムアウト秒（1〜900）
ENEBULAR_TIMEOUT=30

# ===== 関数の環境変数（FN_ を外して envVars として `npm run enebular:config` で送る） =====
# 送った内容で置き換わる。ここに無いキーは実行環境から消える
FN_MOCK_MODE=false
FN_LOG_LEVEL=INFO
# センサーデータのテーブル ID（データストア → テーブル → 設定タブ）。キー: no (string) / ts (number)
FN_DS_TABLE_SENSOR_DATA=
# センサー登録簿テーブル ID（任意。キー: scope (string) / no (string)）。設定すると MCP の list_sensors が使える
FN_DS_TABLE_SENSORS=
# センサー API / MCP のキー（設定すると x-api-key または Bearer を要求。空なら無認証）
FN_API_KEY=
FN_SENSOR_QUERY_LIMIT=100
FN_SENSOR_QUERY_MAX_LIMIT=1000
FN_MCP_SUMMARY_MAX_PAGES=5
# デモ公開用の BASIC 認証（ビューア画面にだけ掛かる）
FN_BASIC_AUTH_USER=
FN_BASIC_AUTH_PASSWORD=
