# ローカル開発用（.env にコピーして使う）。本番の値は enebular 側の envVars に入れる。
# 雛形値（change-me / 000...0）は「未設定」と同じ扱いになる（src/config.ts）。

# ---- 動作モード ----------------------------------------------------------
# true: 外部依存をモックする（デモ既定）。本番は明示的に false にする
MOCK_MODE=true
LOG_LEVEL=INFO
PORT=8787

# ---- データストア --------------------------------------------------------
# memory: インメモリ実装に切り替える（ローカル専用・永続化されない）
# cloud : 実行環境が注入する接続情報を使う（ローカルからは使えない）
DATASTORE_MODE=memory
# テーブル ID は enebular コンソール → データストア → テーブル → 設定タブ
DS_TABLE_ITEMS=00000000-0000-0000-0000-000000000000

# ---- デモ公開用の BASIC 認証（両方そろったときだけ HTML に掛かる） ----------
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
