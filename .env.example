# ローカル開発用（.env にコピーして使う）。本番の値は enebular 側の envVars に入れる（.env.deploy の FN_*）。
# 雛形値（change-me / 000...0）は「未設定」と同じ扱いになる（src/config.ts）。

# ---- 動作モード ----------------------------------------------------------
# true: 外部依存をモックする（デモ既定）。本番は明示的に false にする
MOCK_MODE=true
LOG_LEVEL=INFO
PORT=8787

# ---- データストア --------------------------------------------------------
# memory: インメモリ実装に切り替える（ローカル専用・永続化されない）
# cloud : 実行環境が注入する接続情報を使う（ローカルからは使えない）
DATASTORE_MODE=memory
# センサーデータのテーブル ID（enebular コンソール → データストア → テーブル → 設定タブ）
# キー: メインキー no (string) / サブキー ts (number)。元の Node-RED フローのテーブルをそのまま使える
DS_TABLE_SENSOR_DATA=00000000-0000-0000-0000-000000000000
# センサー登録簿（任意）。設定すると投入時に最新値を書き足し、MCP の list_sensors が使えるようになる
# キー: メインキー scope (string) / サブキー no (string)。未設定なら登録簿は無効（投入 1 件 = アクセス 1 回）
DS_TABLE_SENSORS=

# ---- センサー API --------------------------------------------------------
# 設定すると /v1/sensors と /mcp に x-api-key ヘッダ（または Authorization: Bearer）を要求する。未設定なら無認証（元フローと同じ）
API_KEY=
# limit 省略時の取得件数 / 上限（超えた指定はクランプ）
SENSOR_QUERY_LIMIT=100
SENSOR_QUERY_MAX_LIMIT=1000
# 投入 1 件のボディ上限（バイト）
SENSOR_BODY_LIMIT_BYTES=65536

# ---- MCP ------------------------------------------------------------------
# summarize_sensor_readings が 1 回で辿るページ数の上限（= データストアアクセス回数の上限）
MCP_SUMMARY_MAX_PAGES=5
# list_sensors の既定件数
MCP_LIST_SENSORS_LIMIT=200

# ---- デモ公開用の BASIC 認証（両方そろったときだけ HTML に掛かる） ----------
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
